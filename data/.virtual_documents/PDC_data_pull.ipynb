def build_joined_dataset(merged_data, mapping_df, protein_data, cancer_type):
    print(f"\nbuilding joined dataset for {cancer_type}...\n")
    # 'melt' or 'pivot' data so rows are aliquots; this is needed to match the mapping and the case data
    melted_protein = protein_data.T.reset_index()
    melted_protein = melted_protein.rename(columns={'Gene/Aliquot': 'aliquot_submitter_id', 'index': 'aliquot_submitter_id'})
    print(f"transposed protein matrxi shape {melted_protein.shape} "f"(aliquots x genes)")
    print(f" sample aliquot IDs: {melted_protein['aliquot_submitter_id'].head(3).tolist()}")
    
    #filter mapping by cancer type, and remove dupes as specified by matching on aliquot_submitter_id, case_submitter_id, and sample_type- 
    #this should remove any truly duplicate records, but keep cases where one aliquot maps to multiple samples or sample types (eg tumor and normal)
    mapping = mapping_df[mapping_df['cancer_type'] == cancer_type][
        ['aliquot_submitter_id', 'case_submitter_id', 'sample_type']
    ].drop_duplicates()
    print(f"mapping records for {cancer_type}: {len(mapping)}")
    print(f"example mapping aliquot IDs: {mapping['aliquot_submitter_id'].head(3).tolist()}")
    # confirm overlap between protein aliquot IDs and mapping aliquot IDs
    protein_aliquots = set(melted_protein['aliquot_submitter_id'])
    mapping_aliquots = set(mapping['aliquot_submitter_id'])
    overlap = protein_aliquots.intersection(mapping_aliquots)
    print(f"aliquot ID overlap: {len(overlap)} of {len(protein_aliquots)} " f"protein aliquots found in mapping")
    if len(overlap) == 0:
        print(" **** no aliquot ID overlap, nothing to join")
        return None
    # merge expression data with mapping to include match case_submitter_id for joining with clinical data
    merged_exp = melted_protein.merge(mapping, on='aliquot_submitter_id', how='inner')
    print(f"post-mapping shape : {merged_exp.shape}")

    #some clinical datasets use "Patient ID" instead of "case_submitter_id", so rename if needed for the join
    clinical_df = merged_data.copy()
    if 'Patient ID' in clinical_df.columns:
        clinical_df = clinical_df.rename(
            columns={'Patient ID': 'case_submitter_id'})

    #check how many recods match between the datasets for a sanity check
    exp_cases = set(merged_exp['case_submitter_id'])
    clin_cases = set(clinical_df['case_submitter_id'])
    case_overlap = exp_cases.intersection(clin_cases)
    print(f"case id overlap : {len(case_overlap)} " f"of {len(exp_cases)} cases")

    if len(case_overlap) == 0:
        print(" **** no case ID overlap with clinical data")        
        return None
    
    joined = merged_exp.merge(clinical_df, on='case_submitter_id', how='inner')
    print(f" final joined shape:  {joined.shape[0]} rows x {joined.shape[1]} cols")
    return joined


#merge all the cancer type datasets and the protein exp data together 
def build_all_cancer_types(merged_data, mapping_df, expression_data):
    all_joined = {}
    for cancer_type, protein_df in expression_data.items():
        result = build_joined_dataset(merged_data, mapping_df, protein_df, cancer_type)
        if result is not None:
            all_joined[cancer_type] = result
    if all_joined:
        combined = pd.concat(all_joined.values(), ignore_index=True)
        print(f"\nCombined dataset: {combined.shape[0]} rows x "
              f"{combined.shape[1]} cols")
        combined.to_csv('pdc_joined_all_cancer_types.csv', index=False)
        return all_joined, combined
    return all_joined, None

# some of the breast cancer set aliquor IDs weren't merging; turns out TCGA ID are formatted slightly differently, 
# but the other IDs are can be extracted from within the string- needed a function ato apply to the mapping table 
# to make everything match up 
def normalize_mapping_id(full_id):
    if full_id.startswith('TCGA-'):
        parts = full_id.split('-')
        #elide the first part (TCGA) and any substrings after the 4th...these are the parts that match the shorter IDs
        if len(parts) >= 4:
            return '-'.join(parts[1:4])
    return full_id


